<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext HTTP is required for the local Docker API on :8080 (release + debug). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
