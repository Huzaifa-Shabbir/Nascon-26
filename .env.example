# Copy to .env and fill in. Never commit .env.

# Per-team salt printed on the team slip. Required. Never hard-code or commit it.
DAY1_SALT=REPLACE_WITH_TEAM_SALT

# Signing key for the API's JWTs.
JWT_SECRET=REPLACE_WITH_RANDOM_STRING

# Used only when running the API outside Docker (local dev).
# docker-compose.yml sets its own internal values for these.
DATABASE_URL=postgresql+psycopg://nascon:nascon@localhost:5432/nascon
REDIS_URL=redis://localhost:6379/0
